FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     pimpleFoamScalar;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         200;

deltaT          0.5;
writeControl    timeStep;
writeInterval   5;
purgeWrite      0;

runTimeModifiable true;
maxCo 0.5;
adjustTimeStep yes;




