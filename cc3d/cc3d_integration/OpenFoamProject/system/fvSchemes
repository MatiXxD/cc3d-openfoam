FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    div(phi,U)      Gauss linear;
    div(phi,C)      Gauss upwind;  // если есть скаляр C
    default         none;
}

laplacianSchemes
{
    default         none;
    laplacian(DC,C)  Gauss linear corrected;  // для диффузии C
    laplacian((1|A(U)),p) Gauss linear corrected; // для давления
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}
